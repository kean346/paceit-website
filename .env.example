# Public HTTPS website origin. Confirm the primary domain before changing it.
NEXT_PUBLIC_SITE_URL=https://paceit.co.za

# SERVER ONLY. Add these in Vercel project environment settings; never commit keys.
# Brevo SMTP: use the SMTP login and SMTP key from Brevo's SMTP settings.
# SMTP_PASS is an SMTP key, not your account password or REST API key.
# Sender and recipient are both info@paceit.co.za; visitors become Reply-To.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
